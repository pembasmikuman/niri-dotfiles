#!/bin/sh
# Print "cpuT gpuT ssdT cpuUse gpuUse ramUsedMiB ramTotalMiB" for the System Temps desktop widget.
# Temperatures are whole °C, usage is whole percent; 0 means no reading on this machine.
# Sensors are detected at run time, so the same script works on AMD, Intel and NVIDIA/AMD GPUs.

# Print a hwmon chip's temperature (millidegrees) for the first matching label,
# or temp1 if none of the labels exist.
chip_temp() {
    chip=$1; shift
    for want in "$@"; do
        for l in "$chip"/temp*_label; do
            [ -r "$l" ] && [ "$(cat "$l")" = "$want" ] && { cat "${l%_label}_input"; return; }
        done
    done
    cat "$chip/temp1_input" 2>/dev/null || echo 0
}

# hwmon numbers change between boots, so find each chip by name instead.
cpu=0 cpu_rank=9 ssd=0 amdgpu=""
for h in /sys/class/hwmon/hwmon*; do
    case $(cat "$h/name" 2>/dev/null) in
        # Lower rank wins when a machine exposes more than one CPU sensor.
        k10temp|zenpower) rank=1 t=$(chip_temp "$h" Tdie Tctl) ;;
        coretemp)         rank=1 t=$(chip_temp "$h" "Package id 0") ;;
        cpu_thermal)      rank=2 t=$(chip_temp "$h") ;;
        acpitz)           rank=3 t=$(chip_temp "$h") ;;
        nvme|drivetemp)   # Report the hottest drive.
                          t=$(chip_temp "$h" Composite); [ "$t" -gt "$ssd" ] && ssd=$t; continue ;;
        amdgpu)           amdgpu=$h; continue ;;
        *)                continue ;;
    esac
    [ "$rank" -lt "$cpu_rank" ] && { cpu=$t; cpu_rank=$rank; }
done

# CPU usage: compare the busy/total tick counts over a short pause.
read -r _ u n s i w q sq _ < /proc/stat; t1=$((u + n + s + i + w + q + sq)); i1=$((i + w))
sleep 0.3
read -r _ u n s i w q sq _ < /proc/stat; t2=$((u + n + s + i + w + q + sq)); i2=$((i + w))
use=$(( (t2 - t1) > 0 ? 100 * ((t2 - t1) - (i2 - i1)) / (t2 - t1) : 0 ))

# GPU: NVIDIA through nvidia-smi, else AMD through amdgpu; Intel iGPUs expose neither.
gpu=$(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d ',')
if [ -z "$gpu" ] && [ -n "$amdgpu" ]; then
    busy=$(cat "$amdgpu"/device/gpu_busy_percent 2>/dev/null || echo 0)
    gpu="$(( $(chip_temp "$amdgpu" edge) / 1000 )) $busy"
fi
set -- ${gpu:-0 0}

# RAM: used = total - available, in MiB.
ram=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {printf "%d %d", (t - a) / 1024, t / 1024}' /proc/meminfo)

echo "$((cpu / 1000)) $1 $((ssd / 1000)) $use $2 $ram"
