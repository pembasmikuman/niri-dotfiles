// Personal config. Not managed by dms, safe to edit.

// Hand the login-unlocked KDE Wallet to this session. Plasma does this itself, niri doesn't
spawn-at-startup "/usr/lib/pam_kwallet_init"

layout {
    gaps 6

    shadow {
        on
    }
}

// kitty: see-through when floating and not focused, so windows behind show
window-rule {
    match app-id="^kitty$" is-floating=true is-focused=false
    opacity 0.6
}

// App shortcuts. Mod+C replaces dms's center-column bind
binds {
    Mod+B hotkey-overlay-title="Browser" { spawn "/opt/zen-browser-bin/zen-bin"; }
    Mod+C hotkey-overlay-title="Code" { spawn "code"; }
}
